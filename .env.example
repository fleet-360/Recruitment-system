DATABASE_URL="postgresql://crm:crm@localhost:5432/crm?schema=public"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""
# Google OAuth (office users) — Google Cloud Console → Credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# CV files — folder outside /public, only served through an authorized route
UPLOAD_DIR="./uploads"

# Bulk SMS (S-15) — InforU: the API token exactly as InforU issues it (sent as the Authorization header);
# sender = approved name (max 11 Latin letters) or number, optional. Empty token = dry run (logged, nothing delivered).
INFORU_TOKEN=""
INFORU_SENDER=""

# Daily job (/api/cron/daily) — the server cron sends it as "Authorization: Bearer <value>"
CRON_SECRET=""

# --- Production only (compose.prod.yml on the VPS). Generate secrets with: openssl rand -hex 32
# DOMAIN="crm.example.co.il"
# POSTGRES_PASSWORD=""      # hex only — it goes inside DATABASE_URL
# BACKUP_PASSPHRASE=""      # encrypts the daily backups; keep a copy OUTSIDE the server
# SEED_ADMIN_EMAIL=""       # first admin, used once: docker compose -f compose.prod.yml exec app npx prisma db seed
# SEED_ADMIN_PASSWORD=""
