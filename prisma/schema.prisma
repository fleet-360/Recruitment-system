// Mirrors the ERD in Notion: CRM השמה → איפיון → מודל נתונים

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────── Editable lists (statuses, reasons, sources, languages, regions, cities)

enum ListKey {
  candidate_status
  placement_status
  rejection_reason
  lead_source
  language
  region
  city
}

model LookupValue {
  id           String        @id @default(cuid())
  listKey      ListKey
  label        String
  parentId     String? // city → region
  parent       LookupValue?  @relation("LookupParent", fields: [parentId], references: [id])
  children     LookupValue[] @relation("LookupParent")
  sortOrder    Int           @default(0)
  requiresNote Boolean       @default(false) // e.g. rejection reason "אחר"
  isActive     Boolean       @default(true) // never delete — deactivate
  systemKey    String? // values the code relies on: ready (candidate), rejected / fired (placement). Can be renamed, not deactivated

  candidatesByStatus  Candidate[]         @relation("CandidateStatus")
  candidatesBySource  Candidate[]         @relation("CandidateSource")
  candidatesByCity    Candidate[]         @relation("CandidateCity")
  candidateLanguages  CandidateLanguage[]
  branches            Branch[]
  placementsByStatus  Placement[]         @relation("PlacementStatus")
  placementsRejection Placement[]         @relation("PlacementRejection")

  @@unique([listKey, label])
  @@unique([listKey, systemKey])
  @@index([listKey, isActive, sortOrder])
}

// ───────── Users & auth (Auth.js tables: User, Account, Session, VerificationToken)

enum Role {
  admin
  recruiter
  company_admin
  branch_manager
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String    @unique
  emailVerified      DateTime?
  image              String?
  passwordHash       String? // email + password for everyone; null for Google-only users
  role               Role      @default(recruiter)
  companyId          String? // business users only
  company            Company?  @relation(fields: [companyId], references: [id])
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false) // set when an admin creates the user / resets the password
  createdAt          DateTime  @default(now())

  accounts        Account[]
  sessions        Session[]
  branches        UserBranch[]
  notifications   Notification[]
  ownedCandidates Candidate[]    @relation("CandidateOwner")
  activities      Activity[]
  tasks           Task[]
  jobsCreated     Job[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? // Google refresh token → Calendar / Gmail
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model UserBranch {
  userId   String
  branchId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
}

model Notification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String // job_opened | placement_status | installment_overdue
  entityType String
  entityId   String
  message    String
  createdAt  DateTime  @default(now())
  readAt     DateTime?

  @@index([userId, readAt])
}

// ───────── Companies

model Company {
  id        String   @id @default(cuid())
  name      String
  regNumber String?
  notes     String?
  createdAt DateTime @default(now())

  branches Branch[]
  contacts Contact[]
  jobs     Job[]
  users    User[]
}

enum FeeType {
  fixed
  percent_of_salary
}

model Branch {
  id        String       @id @default(cuid())
  companyId String
  company   Company      @relation(fields: [companyId], references: [id])
  name      String
  cityId    String?
  city      LookupValue? @relation(fields: [cityId], references: [id])
  address   String?
  feeType   FeeType?
  feeValue  Decimal?     @db.Decimal(12, 2) // ₪ amount or percent

  paymentTerms PaymentTerm[]
  contacts     Contact[]
  jobs         Job[]
  users        UserBranch[]
}

model PaymentTerm {
  id             String  @id @default(cuid())
  branchId       String
  branch         Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  seq            Int
  sharePercent   Decimal @db.Decimal(5, 2) // share of total fee
  daysAfterStart Int // 0 = on start date

  @@unique([branchId, seq])
}

model Contact {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  branchId  String?
  branch    Branch? @relation(fields: [branchId], references: [id])
  name      String
  role      String?
  phone     String?
  email     String?
}

enum JobStatus {
  open
  closed
}

model Job {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  branchId    String
  branch      Branch    @relation(fields: [branchId], references: [id])
  title       String
  description String?
  salary      Decimal?  @db.Decimal(12, 2)
  openings    Int       @default(1)
  status      JobStatus @default(open)
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  placements Placement[]

  @@index([branchId, status])
}

// ───────── Candidates

model Candidate {
  id               String       @id @default(cuid())
  fullName         String
  phone            String       @unique // duplicate check
  email            String?
  birthDate        DateTime?    @db.Date
  cityId           String?
  city             LookupValue? @relation("CandidateCity", fields: [cityId], references: [id])
  statusId         String?
  status           LookupValue? @relation("CandidateStatus", fields: [statusId], references: [id])
  sourceId         String?
  source           LookupValue? @relation("CandidateSource", fields: [sourceId], references: [id])
  summary          String? // visible to businesses
  ownerUserId      String?
  owner            User?        @relation("CandidateOwner", fields: [ownerUserId], references: [id])
  marketingConsent Boolean      @default(false)
  anonymizedAt     DateTime? // personal data erased on request (NFR-02); row kept for placements / billing
  createdAt        DateTime     @default(now())

  languages  CandidateLanguage[]
  files      CandidateFile[]
  placements Placement[]
  interviews Interview[]
  activities Activity[]
  tasks      Task[]
  lead       Lead?
}

model CandidateLanguage {
  candidateId String
  languageId  String
  candidate   Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  language    LookupValue @relation(fields: [languageId], references: [id])

  @@id([candidateId, languageId])
}

model CandidateFile {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  storagePath String // relative to UPLOAD_DIR, never public
  filename    String
  uploadedAt  DateTime  @default(now())
}

model Lead {
  id          String     @id @default(cuid())
  metaLeadId  String     @unique
  campaign    String?
  fullName    String?
  phone       String?
  raw         Json
  receivedAt  DateTime   @default(now())
  candidateId String?    @unique
  candidate   Candidate? @relation(fields: [candidateId], references: [id])
}

// ───────── Placement = candidate × job

model Placement {
  id                String       @id @default(cuid())
  candidateId       String
  candidate         Candidate    @relation(fields: [candidateId], references: [id])
  jobId             String
  job               Job          @relation(fields: [jobId], references: [id])
  statusId          String?
  status            LookupValue? @relation("PlacementStatus", fields: [statusId], references: [id])
  rejectionReasonId String?
  rejectionReason   LookupValue? @relation("PlacementRejection", fields: [rejectionReasonId], references: [id])
  rejectionNote     String?
  salary            Decimal?     @db.Decimal(12, 2) // for percent_of_salary fee
  startDate         DateTime?    @db.Date // setting it generates installments
  endDate           DateTime?    @db.Date // fired
  endReason         String?
  feeType           FeeType? // branch terms copied when installments are created — later term changes don't apply
  feeValue          Decimal?     @db.Decimal(12, 2)
  createdAt         DateTime     @default(now())

  interviews   Interview[]
  installments Installment[]
  activities   Activity[]

  @@unique([candidateId, jobId])
}

model Interview {
  id            String     @id @default(cuid())
  candidateId   String
  candidate     Candidate  @relation(fields: [candidateId], references: [id])
  placementId   String? // office screening has none
  placement     Placement? @relation(fields: [placementId], references: [id])
  scheduledAt   DateTime
  location      String?
  googleEventId String?
}

enum InstallmentStatus {
  expected
  paid
  cancelled
}

model Installment {
  id             String            @id @default(cuid())
  placementId    String
  placement      Placement         @relation(fields: [placementId], references: [id], onDelete: Cascade)
  seq            Int
  sharePercent   Decimal           @db.Decimal(5, 2) // copied from the branch term
  daysAfterStart Int
  dueDate        DateTime          @db.Date
  amount         Decimal           @db.Decimal(12, 2)
  status         InstallmentStatus @default(expected)
  paidAt         DateTime?         @db.Date
  task           Task?

  @@unique([placementId, seq])
  @@index([dueDate, status])
}

// ───────── History, notes, tasks

enum ActivityType {
  note
  call
  whatsapp
  status_change
  billing // installments created / recalculated / cancelled
}

model Activity {
  id          String       @id @default(cuid())
  candidateId String
  candidate   Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  placementId String?
  placement   Placement?   @relation(fields: [placementId], references: [id])
  userId      String?
  user        User?        @relation(fields: [userId], references: [id])
  type        ActivityType
  fromValue   String?
  toValue     String?
  body        String?
  createdAt   DateTime     @default(now())

  @@index([candidateId, createdAt])
}

// NFR-02 access log (Data Security Regulations): sign-ins and CV views. No FK on purpose — failed sign-ins may name no user,
// and rows must survive user changes.
model AccessLog {
  id        String   @id @default(cuid())
  action    String // login_ok | login_fail | cv_view
  email     String?
  userId    String?
  entityId  String? // CandidateFile id for cv_view
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Task {
  id            String       @id @default(cuid())
  candidateId   String?
  candidate     Candidate?   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  assignedToId  String
  assignedTo    User         @relation(fields: [assignedToId], references: [id])
  installmentId String?      @unique // collection task opened by the daily job — one per late installment
  installment   Installment? @relation(fields: [installmentId], references: [id], onDelete: SetNull)
  title         String
  dueAt         DateTime // date only (decided 23/09/2026): UTC midnight of the Israeli date, like @db.Date columns
  doneAt        DateTime?

  @@index([assignedToId, doneAt, dueAt])
}
